// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum JobStatus {
  OPEN
  DRAFT
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                       String   @id @default(cuid())
  email                    String   @unique
  password                 String
  fullName                 String
  avatarUrl                String?
  role                     String   @default("CLIENT")
  isKycVerified            Boolean  @default(false)
  isOnline                 Boolean  @default(false)
  title                    String?
  location                 String?
  bio                      String?
  hourlyRate               Int?
  availabilityHoursPerWeek Int?
  skills                   String   @default("[]")
  successRate              Float    @default(0)
  totalContracts           Int      @default(0)
  rating                   Float    @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  walletAddress            String?  @unique

  badges               Badge[]
  portfolioItems       PortfolioItem[]
  experience           Experience[]
  clientContracts      Contract[]      @relation("ClientContracts")
  freelancerContracts  Contract[]      @relation("FreelancerContracts")
  sentMessages         Message[]
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  jobs                 Job[]           @relation("ClientJobs")
  applications         Application[]   @relation("FreelancerApplications")
}

model Contract {
  id              String         @id @default(cuid())
  title           String
  partnerName     String
  description     String?
  status          String         @default("DRAFT")
  totalValue      Decimal
  escrowedAmount  Decimal        @default(0)
  startDate       String?
  endDate         String?
  progressPercent Int            @default(0)
  paymentTerm     String         @default("ESCROW_MILESTONE")
  specialTerms    String?
  freelancerId    String
  clientId        String
  jobId           String?        @unique
  smartContractAddress String?
  datumHash       String?
  txHash          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  freelancer User      @relation("FreelancerContracts", fields: [freelancerId], references: [id])
  client     User      @relation("ClientContracts", fields: [clientId], references: [id])
  job        Job?      @relation("JobContract", fields: [jobId], references: [id])
  milestones Milestone[]
  messages   Message[]
  payments   Payment[]
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String?
  budget      Float
  duration    String?
  deadline    DateTime?
  skills      String    @default("[]")
  status      String    @default("OPEN")
  clientId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client       User          @relation("ClientJobs", fields: [clientId], references: [id])
  applications Application[]
  contract     Contract?     @relation("JobContract")
}

model Application {
  id             String  @id @default(cuid())
  jobId          String
  freelancerId   String
  coverLetter    String?
  proposedBudget Float?
  status         String  @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer User @relation("FreelancerApplications", fields: [freelancerId], references: [id])

  @@unique([jobId, freelancerId])
}

model Milestone {
  id              String          @id @default(cuid())
  name            String
  budget          Int
  deadline        String
  status          String          @default("PENDING")
  progressPercent Int             @default(0)
  submissionNote  String?
  rejectionNote   String?
  submittedAt     DateTime?
  contractId      String
  createdAt       DateTime        @default(now())

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  payments Payment[]
  files    MilestoneFile[]
}

model MilestoneFile {
  id          String   @id @default(cuid())
  url         String
  milestoneId String
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model Message {
  id            String      @id @default(cuid())
  contractId    String
  senderId      String
  senderName    String
  senderAvatar  String?
  type          String      @default("TEXT")
  text          String?
  fileUrl       String?
  fileName      String?
  fileSizeBytes Int?
  milestoneNote String?
  createdAt     DateTime    @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  contractId  String
  milestoneId String?
  amount      Int
  status      String        @default("PENDING")
  txHash      String?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  contract  Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id     String @id @default(cuid())
  label  String
  icon   String
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioItem {
  id          String  @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  tag         String?
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String  @id @default(cuid())
  role        String
  company     String
  startYear   Int
  endYear     Int?
  description String?
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
